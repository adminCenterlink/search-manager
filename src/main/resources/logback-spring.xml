<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- application.yml의 설정값을 가져옵니다 -->
    <springProperty scope="context" name="LOG_HOME" source="logging.file.path" defaultValue="/app/upload/logs"/>
    <springProperty scope="context" name="LOG_FILE_NAME" source="spring.application.name" defaultValue="search-manager"/>
    <springProperty scope="context" name="LOG_PORT" source="server.port" defaultValue="8080"/>
    
    <timestamp key="BY_DATE" datePattern="yyyy-MM-dd" />

    <!-- 콘솔 Appender (공통) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 기본(Default) 및 Dev/Stg 프로파일용 파일 Appender -->
    <!-- 프로파일이 명시되지 않았거나 dev, stg일 때 적용 -->
    <springProfile name="default,local,dev,stg">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <filter class="ch.qos.logback.classic.filter.LevelFilter">
                <level>info</level>
                <onMatch>ACCEPT</onMatch>
                <onMismatch>DENY</onMismatch>
            </filter>
            <!-- 현재 로그 파일 -->
            <file>${LOG_HOME}/${LOG_FILE_NAME}/${LOG_FILE_NAME}-${LOG_PORT}.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>

            <!-- 일자별 + 크기별 로테이션 정책 -->
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <!-- 아카이브 파일 이름 패턴: search-manager-8080.2023-11.0.gz -->
                <fileNamePattern>${LOG_HOME}/${LOG_FILE_NAME}/${LOG_FILE_NAME}-${LOG_PORT}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxHistory>30</maxHistory>       <!-- 30일 보관 -->
                <maxFileSize>10MB</maxFileSize>   <!-- 파일당 최대 10MB -->
                <totalSizeCap>500MB</totalSizeCap> <!-- 전체 로그 최대 500MB -->
            </rollingPolicy>
        </appender>

        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>warn</level> <!-- WARN 이상만 기록 -->
            </filter>
            <file>${LOG_HOME}/${LOG_FILE_NAME}/errors/${LOG_FILE_NAME}-${LOG_PORT}.error.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_HOME}/${LOG_FILE_NAME}/errors/${LOG_FILE_NAME}-${LOG_PORT}.error.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxHistory>30</maxHistory>
                <maxFileSize>10MB</maxFileSize>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="info">
            <appender-ref ref="FILE"/>
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        
        <!-- 특정 패키지 로깅 레벨 조정 -->
        <logger name="com.search.manager" level="info"/>
    </springProfile>

    <!-- Prod 프로파일용 설정 (필요시 활성화) -->
    <springProfile name="prod">
        <appender name="PROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_HOME}/logs/${LOG_FILE_NAME}/${LOG_FILE_NAME}.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_HOME}/logs/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxHistory>60</maxHistory>
                <maxFileSize>100MB</maxFileSize>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <appender name="PROD_ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>warn</level>
            </filter>
            <file>${LOG_HOME}/logs/${LOG_FILE_NAME}/${LOG_FILE_NAME}.error.log</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_HOME}/logs/${LOG_FILE_NAME}/${LOG_FILE_NAME}.error.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
                <maxHistory>60</maxHistory>
                <maxFileSize>50MB</maxFileSize>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <root level="info">
            <appender-ref ref="PROD_FILE"/>
            <appender-ref ref="PROD_ERROR_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>